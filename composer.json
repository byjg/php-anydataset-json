{
  "name": "byjg/anydataset-json",
  "description": "JSON abstraction dataset. Anydataset is an agnostic data source abstraction layer in PHP.",
  "autoload": {
    "psr-4": {
      "ByJG\\AnyDataset\\Json\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-json": "*",
    "byjg/anydataset": "^7.0"
  },
  "suggest": {
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "provide": {
    "byjg/anydataset-implementation": "1.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm"
    ]
  },
  "license": "MIT"
}
